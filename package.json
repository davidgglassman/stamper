{
  "name": "stamper-cli",
  "description": "CLI for scaffolding projects from Nunjucks templates with interactive questions",
  "version": "1.0.1",
  "author": "David Glassman",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "cli",
    "scaffold",
    "template",
    "generator",
    "nunjucks",
    "project"
  ],
  "homepage": "https://github.com/davidgglassman/stamper#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidgglassman/stamper.git"
  },
  "bugs": {
    "url": "https://github.com/davidgglassman/stamper/issues"
  },
  "bin": {
    "stamper-cli": "./bin/index.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "serve": "node ./bin/index.js",
    "build": "eslint . && tsc -b",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.6.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "conf": "^13.0.1",
    "figlet": "^1.8.2",
    "js-yaml": "^4.1.0",
    "nunjucks": "^3.2.4",
    "ora": "^8.2.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/figlet": "^1.7.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/nunjucks": "^3.2.6",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
